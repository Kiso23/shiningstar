# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database
POSTGRES_USER=ssu
POSTGRES_PASSWORD=
POSTGRES_DB=ssu_tournament

# ── Optional (defaults shown) ──────────────────────────────────────────────────
PORT=80
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed origins (JSON array string)
CORS_ORIGINS=["https://yourdomain.com"]

# ── SMTP Email ─────────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email notifications
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_TLS=true
# Use an App Password if 2FA is enabled on Gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@shiningstarunited.com
