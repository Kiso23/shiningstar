# ══════════════════════════════════════════════════════════════════════════════
# PRODUCTION environment TEMPLATE — backend/.env.production
# 
# INSTRUCTIONS:
# 1. Copy this file: cp backend/.env.production.template backend/.env.production
# 2. Fill in ALL the values marked with <REPLACE_...>
# 3. Secure the file: chmod 600 backend/.env.production
# 4. NEVER commit backend/.env.production to version control
# ══════════════════════════════════════════════════════════════════════════════

# ── Database (PostgreSQL for production) ──────────────────────────────────────
# Replace with your actual PostgreSQL credentials
# Format: postgresql+asyncpg://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://ssu:<REPLACE_WITH_STRONG_DB_PASSWORD>@localhost:5432/ssu_tournament

# ── Auth ───────────────────────────────────────────────────────────────────────
# REQUIRED: Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the dev key here
SECRET_KEY=<REPLACE_WITH_GENERATED_SECRET_KEY>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── File uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── CORS (your actual domain) ──────────────────────────────────────────────────
# Replace yourdomain.com with your actual production domain
CORS_ORIGINS=["https://<REPLACE_WITH_YOUR_DOMAIN>","http://localhost:4173"]

# ── SMTP Email ─────────────────────────────────────────────────────────────────
# For Gmail: Use an App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=<REPLACE_WITH_YOUR_EMAIL>
SMTP_PASSWORD=<REPLACE_WITH_APP_PASSWORD>
SMTP_FROM=shiningstarunited
